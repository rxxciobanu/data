# Anthropic API key for Claude-powered agent debates
ANTHROPIC_API_KEY=your-anthropic-api-key

# Gmail SMTP settings (use an App Password, not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
ALERT_RECIPIENT=recipient@example.com

# Polymarket API endpoints
POLYMARKET_HOST=https://clob.polymarket.com
GAMMA_API_HOST=https://gamma-api.polymarket.com

# Orchestrator settings
ALERT_THRESHOLD=0.10
MAX_MARKETS=10

# Aggregation method: "extremized" (recommended), "log_odds", or "weighted_avg"
AGGREGATION_METHOD=extremized

# Position sizing — Kelly Criterion (set BANKROLL > 0 to enable)
BANKROLL=0                  # Your total bankroll in USD. $0 = sizing disabled.
KELLY_FRACTION=0.25         # Fractional Kelly (0.25 = quarter-Kelly, safer)
MAX_BET_PCT=0.05            # Max bet per market as fraction of bankroll (5%)
MAX_TOTAL_EXPOSURE=0.25     # Max total exposure across all bets (25%)
MIN_BET_SIZE=5              # Minimum actionable bet in USD

# News integration (agents get real-time news context for better predictions)
NEWSDATA_API_KEY=              # Optional: NewsData.io API key (free at newsdata.io, 200 req/day)
NEWS_ENABLED=true              # Set false to disable news fetching entirely
NEWS_MAX_ARTICLES=5            # Max articles injected per market debate

# Whale wallet tracking (auto-discovers top traders from Polymarket leaderboard)
WHALE_ENABLED=false                    # Set true to enable whale tracking
WHALE_LEADERBOARD_COUNT=20             # How many top traders to auto-discover (30d profit)
WHALE_EXTRA_WALLETS=                   # Optional: JSON array or path to wallets.json
                                       # Format: [{"address":"0x...","label":"Alpha"}]
WHALE_STATE_PATH=~/.polymarket/whale_state.json  # Persists state between runs
WHALE_MIN_TRADE_SIZE=1000              # Ignore trades below this USD amount
